export type EventPhase = "before" | "after" | "observe";

export interface EventEnvelope<T = unknown> {
  schema?: string;
  sequence?: number;
  topic: string;
  source?: string;
  phase?: EventPhase;
  cancelable?: boolean;
  payload?: T;
  metadata?: Record<string, unknown>;
}

export interface EventSubscriptionOptions {
  priority?: number;
  once?: boolean;
}

export interface EventEmitOptions {
  source?: string;
  phase?: EventPhase;
  cancelable?: boolean;
  broadcast?: boolean;
  metadata?: Record<string, unknown>;
}

export interface EventEmitCommand<T = unknown> {
  op: "events.emit";
  topic: string;
  source: string;
  phase: EventPhase;
  cancelable: boolean;
  payload: T;
  metadata: Record<string, unknown>;
}

export type EventHandler<T = unknown> = (event: ScriptEvent<T>) => unknown;

interface EventSubscription {
  id: number;
  pattern: string;
  handler: EventHandler;
  priority: number;
  once: boolean;
}

class EventTopic {
  static normalize(topic: unknown): string {
    const normalized = String(topic ?? "").trim().toLowerCase();
    if (!normalized) throw new Error("event topic is empty");
    if (
      normalized.startsWith(".") ||
      normalized.endsWith(".") ||
      normalized.includes("..")
    ) {
      throw new Error("invalid event topic: " + normalized);
    }
    if (!/^[a-z0-9_.:-]+$/.test(normalized)) {
      throw new Error("unsupported event topic: " + normalized);
    }
    return normalized;
  }

  static normalizePattern(pattern: unknown): string {
    const normalized = String(pattern ?? "").trim().toLowerCase();
    if (!normalized) throw new Error("event subscription pattern is empty");
    if (
      normalized.startsWith(".") ||
      normalized.endsWith(".") ||
      normalized.includes("..")
    ) {
      throw new Error("invalid event subscription pattern: " + normalized);
    }
    if (!/^[a-z0-9_.*:-]+$/.test(normalized)) {
      throw new Error("unsupported event subscription pattern: " + normalized);
    }
    return normalized;
  }

  static matches(pattern: string, topic: string): boolean {
    if (pattern === topic || pattern === "**") return true;
    return this.matchSegments(pattern.split("."), topic.split("."));
  }

  private static matchSegments(
    pattern: string[],
    topic: string[],
    patternIndex = 0,
    topicIndex = 0,
  ): boolean {
    while (patternIndex < pattern.length) {
      const part = pattern[patternIndex];
      if (part === "**") {
        if (patternIndex === pattern.length - 1) return true;
        for (let skip = topicIndex; skip <= topic.length; skip++) {
          if (this.matchSegments(pattern, topic, patternIndex + 1, skip)) {
            return true;
          }
        }
        return false;
      }

      if (topicIndex >= topic.length) return false;
      if (part !== "*" && part !== topic[topicIndex]) return false;
      patternIndex++;
      topicIndex++;
    }
    return topicIndex === topic.length;
  }
}

class EventValue {
  static phase(value: unknown): EventPhase {
    return value === "before" || value === "after" ? value : "observe";
  }

  static integer(value: unknown, fallback: number): number {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? Math.trunc(parsed) : fallback;
  }
}

export class ScriptEvent<T = unknown> {
  readonly topic: string;
  readonly source: string;
  readonly phase: EventPhase;
  readonly cancelable: boolean;
  readonly sequence: number;
  readonly payload: T;
  readonly metadata: Record<string, unknown>;

  defaultPrevented = false;
  propagationStopped = false;

  constructor(envelope: EventEnvelope<T>) {
    this.topic = EventTopic.normalize(envelope.topic);
    this.source = String(envelope.source ?? "unknown");
    this.phase = EventValue.phase(envelope.phase);
    this.cancelable = envelope.cancelable === true;
    this.sequence = EventValue.integer(envelope.sequence, 0);
    this.payload = envelope.payload as T;
    this.metadata =
      envelope.metadata && typeof envelope.metadata === "object"
        ? { ...envelope.metadata }
        : {};
  }

  preventDefault(): void {
    if (this.cancelable) this.defaultPrevented = true;
  }

  stopPropagation(): void {
    this.propagationStopped = true;
  }

  consume(): void {
    this.preventDefault();
    this.stopPropagation();
  }
}

export class EventBus {
  private nextSubscriptionId = 1;
  private readonly subscriptions: EventSubscription[] = [];
  private readonly outboundCommands: EventEmitCommand[] = [];
  private readonly lastByTopic = new Map<string, ScriptEvent>();
  private readonly countsByTopic = new Map<string, number>();

  on<T = unknown>(
    pattern: string,
    handler: EventHandler<T>,
    options: EventSubscriptionOptions = {},
  ): number {
    if (typeof handler !== "function") {
      throw new Error("event handler must be a function");
    }

    const id = this.nextSubscriptionId++;
    this.subscriptions.push({
      id,
      pattern: EventTopic.normalizePattern(pattern),
      handler: handler as EventHandler,
      priority: EventValue.integer(options.priority, 0),
      once: options.once === true,
    });
    return id;
  }

  once<T = unknown>(
    pattern: string,
    handler: EventHandler<T>,
    options: Omit<EventSubscriptionOptions, "once"> = {},
  ): number {
    return this.on(pattern, handler, { ...options, once: true });
  }

  off(subscriptionId: number): boolean {
    const index = this.subscriptions.findIndex(
      (subscription) => subscription.id === subscriptionId,
    );
    if (index < 0) return false;
    this.subscriptions.splice(index, 1);
    return true;
  }

  clear(pattern?: string): number {
    if (pattern === undefined) {
      const count = this.subscriptions.length;
      this.subscriptions.length = 0;
      return count;
    }

    const normalized = EventTopic.normalizePattern(pattern);
    let removed = 0;
    for (let index = this.subscriptions.length - 1; index >= 0; index--) {
      if (this.subscriptions[index].pattern === normalized) {
        this.subscriptions.splice(index, 1);
        removed++;
      }
    }
    return removed;
  }

  emit<T = unknown>(
    topic: string,
    payload: T,
    options: EventEmitOptions = {},
  ): ScriptEvent<T> {
    const normalizedTopic = EventTopic.normalize(topic);
    const phase = EventValue.phase(options.phase);
    const cancelable = options.cancelable === true;
    const source = String(options.source ?? "project.script");
    const metadata: Record<string, unknown> = {
      ...(options.metadata ?? {}),
      script_echo: false,
    };

    const event = this.dispatch({
      schema: "newviso.event.v1",
      sequence: 0,
      topic: normalizedTopic,
      source,
      phase,
      cancelable,
      payload,
      metadata,
    }) as ScriptEvent<T>;

    metadata.default_prevented = event.defaultPrevented;

    if (options.broadcast !== false) {
      this.outboundCommands.push({
        op: "events.emit",
        topic: normalizedTopic,
        source,
        phase,
        cancelable,
        payload,
        metadata,
      });
    }

    return event;
  }

  dispatchIncoming<T = unknown>(envelope: EventEnvelope<T>): ScriptEvent<T> {
    if (!envelope || typeof envelope !== "object") {
      throw new Error("incoming event envelope must be an object");
    }
    return this.dispatch(envelope) as ScriptEvent<T>;
  }

  drainCommands(): EventEmitCommand[] {
    if (this.outboundCommands.length === 0) return [];
    return this.outboundCommands.splice(0, this.outboundCommands.length);
  }

  last<T = unknown>(topic: string): ScriptEvent<T> | undefined {
    return this.lastByTopic.get(EventTopic.normalize(topic)) as
      | ScriptEvent<T>
      | undefined;
  }

  count(topic: string): number {
    return this.countsByTopic.get(EventTopic.normalize(topic)) ?? 0;
  }

  subscriptionCount(): number {
    return this.subscriptions.length;
  }

  matches(pattern: string, topic: string): boolean {
    return EventTopic.matches(
      EventTopic.normalizePattern(pattern),
      EventTopic.normalize(topic),
    );
  }

  private dispatch<T = unknown>(envelope: EventEnvelope<T>): ScriptEvent<T> {
    const event = new ScriptEvent(envelope);
    this.lastByTopic.set(event.topic, event);
    this.countsByTopic.set(
      event.topic,
      (this.countsByTopic.get(event.topic) ?? 0) + 1,
    );

    const matching = this.subscriptions
      .filter((subscription) =>
        EventTopic.matches(subscription.pattern, event.topic),
      )
      .slice()
      .sort((a, b) => b.priority - a.priority || a.id - b.id);

    for (const subscription of matching) {
      const result = subscription.handler(event);
      if (subscription.once) this.off(subscription.id);
      if (result === false && event.cancelable) event.preventDefault();
      if (event.propagationStopped) break;
    }

    return event;
  }
}

export const Events: EventBus = new EventBus();
