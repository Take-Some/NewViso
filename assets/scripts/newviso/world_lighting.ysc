import {
  celestialCommands,
  celestialShutdownCommands,
} from "./world/celestial.ysc";

type FramePayload = {
  elapsed_seconds?: number;
};

function elapsedSeconds(payload: FramePayload | unknown): number {
  if (!payload || typeof payload !== "object") return 0.0;
  const value = (payload as FramePayload).elapsed_seconds;
  return typeof value === "number" && Number.isFinite(value) ? value : 0.0;
}

export function on_start(payload: unknown) {
  return {
    scene: {
      commands: celestialCommands(elapsedSeconds(payload)),
    },
  };
}

export function on_frame(payload: FramePayload) {
  return {
    scene: {
      commands: celestialCommands(elapsedSeconds(payload)),
    },
  };
}

export function on_shutdown(_payload: unknown) {
  return {
    scene: {
      commands: celestialShutdownCommands(),
    },
  };
}
