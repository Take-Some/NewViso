import type { Vec3 } from "./living_world.ysc";

export type WorldSimulationTier = "full" | "reduced" | "background";

export interface WorldActorState<TState = unknown> {
  id: string;
  kind: string;
  position: Vec3;
  enabled: boolean;
  state: TState;
  simulation_tier: WorldSimulationTier;
  representation: "physical" | "proxy" | "abstract";
  last_update_world_seconds: number;
  next_update_world_seconds: number;
  zones: string[];
}

export interface WorldProcessActivation<TPayload = unknown> {
  id: string;
  priority: number;
  due_world_seconds: number;
  delivered_world_seconds: number;
  lateness_seconds: number;
  occurrences: number;
  tags: string[];
  payload: TPayload;
}

export interface WorldEventDelivery<TPayload = unknown> {
  id: string;
  kind: string;
  source: string;
  cause: string | null;
  reality_event_id: string;
  due_world_seconds: number;
  delivered_world_seconds: number;
  lateness_seconds: number;
  payload: TPayload;
}

export interface WorldFact<TValue = unknown> {
  key: string;
  value: TValue;
  revision: number;
  updated_world_seconds: number;
}

export interface WorldActiveTravel<TPayload = unknown> {
  actor_id: string;
  route: string[];
  next_waypoint_index: number;
  destination_node: string;
  speed: number;
  mode: string;
  started_world_seconds: number;
  distance_travelled: number;
  payload: TPayload;
}

export interface WorldTravelCompletion<TPayload = unknown> {
  actor_id: string;
  destination_node: string;
  mode: string;
  world_seconds: number;
  distance_travelled: number;
  payload: TPayload;
}

export interface WorldRealityRecord<TPayload = unknown> {
  id: string;
  sequence: number;
  kind: string;
  source: string;
  cause: string | null;
  occurred_world_seconds: number;
  participants: string[];
  position: Vec3 | null;
  importance: number;
  tags: string[];
  payload: TPayload;
}

export interface LivingWorldState {
  clock: {
    world_seconds: number;
    fixed_tick: number;
    fixed_hz: number;
    time_scale: number;
    last_frame_steps: number;
    backlog_seconds: number;
  };
  simulation: {
    actors: WorldActorState[];
    frame_actor_updates: {
      actor_id: string;
      simulation_tier: WorldSimulationTier;
      delta_seconds: number;
      world_seconds: number;
      fixed_tick: number;
    }[];
    frame_representation_changes: {
      actor_id: string;
      previous: string;
      current: string;
      world_seconds: number;
      fixed_tick: number;
    }[];
  };
  persistence?: { enabled: boolean; restored?: boolean; recovered_backup?: boolean; last_error?: string | null };
  presentation_transitions?: { actor_id: string; scene_key: string; materialized: boolean; entity_id: number | null }[];
  presentations?: { actor_id: string; scene_key: string; logical_position: Vec3 | null; representation: string | null; scene_entity: unknown }[];
  processes: { frame_due: WorldProcessActivation[] };
  events: { frame_due: WorldEventDelivery[]; dropped_expired: number };
  facts: WorldFact[];
  reality: { history: WorldRealityRecord[]; frame_events: WorldRealityRecord[] };
  navigation: {
    nodes: { id: string; position: Vec3; tags: string[]; parameters: Record<string, number> }[];
    edges: {
      id: string; from: string; to: string; bidirectional: boolean;
      distance: number | null; cost_scale: number; enabled: boolean;
      tags: string[]; parameters: Record<string, number>;
    }[];
    active_travel: WorldActiveTravel[];
    frame_completions: WorldTravelCompletion[];
  };
}

/** A typed view of the authoritative backend snapshot delivered to on_frame. */
export class LivingWorldView {
  readonly state: LivingWorldState;

  constructor(state: LivingWorldState) {
    this.state = state;
  }

  static fromFrame(payload: unknown): LivingWorldView | undefined {
    if (!payload || typeof payload !== "object") return undefined;
    const state = (payload as { runtime?: { living_world?: LivingWorldState } })
      .runtime?.living_world;
    if (!state || !Number.isFinite(state.clock?.world_seconds)) return undefined;
    return new LivingWorldView(state);
  }

  factNumber(key: string, fallback: number): number {
    const value = this.state.facts.find(fact => fact.key === key)?.value;
    return typeof value === "number" && Number.isFinite(value) ? value : fallback;
  }

  factBoolean(key: string, fallback: boolean): boolean {
    const value = this.state.facts.find(fact => fact.key === key)?.value;
    return typeof value === "boolean" ? value : fallback;
  }

  actor(id: string): WorldActorState | undefined {
    return this.state.simulation.actors.find(actor => actor.id === id);
  }

  activeTravel(actorId: string): WorldActiveTravel | undefined {
    return this.state.navigation?.active_travel?.find(travel => travel.actor_id === actorId);
  }
}
