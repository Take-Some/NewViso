export type Vec2 = [number, number];
export type Vec3 = [number, number, number];

export function clamp01(value: number): number {
  return Math.max(0.0, Math.min(1.0, value));
}

export function smoothstep(edge0: number, edge1: number, value: number): number {
  if (edge0 === edge1) return value < edge0 ? 0.0 : 1.0;
  const t = clamp01((value - edge0) / (edge1 - edge0));
  return t * t * (3.0 - 2.0 * t);
}

export function smootherstep(edge0: number, edge1: number, value: number): number {
  if (edge0 === edge1) return value < edge0 ? 0.0 : 1.0;
  const t = clamp01((value - edge0) / (edge1 - edge0));
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

export function mix(a: number, b: number, t: number): number {
  return a + (b - a) * clamp01(t);
}

export function mix3(a: Vec3, b: Vec3, t: number): Vec3 {
  return [
    mix(a[0], b[0], t),
    mix(a[1], b[1], t),
    mix(a[2], b[2], t),
  ];
}

export function orbitPhaseDegrees(
  elapsedSeconds: number,
  durationSeconds: number,
  phaseOffsetDegrees: number,
): number {
  const duration = Math.max(0.0001, Math.abs(durationSeconds));
  const phase = (elapsedSeconds / duration) * 360.0 + phaseOffsetDegrees;
  return ((phase % 360.0) + 360.0) % 360.0;
}

export function orbitElevationDegrees(
  phaseDegrees: number,
  maxElevationDegrees: number,
): number {
  return Math.sin(phaseDegrees * Math.PI / 180.0) * maxElevationDegrees;
}

export function orbitRotationDegrees(
  elevationDegrees: number,
  yawBaseDegrees: number,
  phaseDegrees: number,
  yawRate: number,
): Vec3 {
  return [
    -elevationDegrees,
    yawBaseDegrees + phaseDegrees * yawRate,
    0.0,
  ];
}
