type FramePayload = {
  elapsed_seconds?: number;
};

const sun = "world.primary_light";

function sunRotation(elapsedSeconds: number): [number, number, number] {
  // Game-level accelerated day cycle. The engine only receives a transform.
  const cycle = elapsedSeconds * 0.018;
  const pitch = -35.0 + Math.sin(cycle) * 55.0;
  const yaw = 115.0 + (cycle * 180.0 / Math.PI);
  return [pitch, yaw, 0.0];
}

export function on_start(_payload: unknown) {
  return {
    scene: {
      commands: [
        {
          op: "scene.light.upsert",
          id: sun,
          light_type: "directional",
          color: [1.0, 0.94, 0.82],
          intensity: 1.35,
          casts_shadows: true,
          shadow_bias: 0.0018,
          shadow_normal_bias: 0.025,
          shadow_resolution: 2048,
          shadow_distance: 96.0
        },
        {
          op: "scene.entity.transform.set",
          id: sun,
          rotation_degrees: [-35.0, 115.0, 0.0]
        }
      ]
    }
  };
}

export function on_frame(payload: FramePayload) {
  const elapsed = typeof payload.elapsed_seconds === "number"
    ? payload.elapsed_seconds
    : 0.0;

  return {
    scene: {
      commands: [
        {
          op: "scene.entity.transform.set",
          id: sun,
          rotation_degrees: sunRotation(elapsed)
        }
      ]
    }
  };
}

export function on_shutdown(_payload: unknown) {
  return {};
}
