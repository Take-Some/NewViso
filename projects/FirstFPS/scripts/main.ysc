import { Events } from "./newviso/events.ysc";
import { livingTransport } from "./world/living_transport.ysc";
import { livingWorldDemo } from "./world/living_simulation.ysc";
import { frameGame, shutdownGame, startGame } from "./fps/game.ysc";
import {
  on_frame as frameWorldLighting,
  on_shutdown as shutdownWorldLighting,
  on_start as startWorldLighting,
} from "./world/lighting.ysc";

type ScriptResult = {
  exit_requested?: boolean;
  runtime?: { exit_requested?: boolean };
  commands?: unknown[];
  scene?: { commands?: unknown[] };
  ui?: { bindings?: Record<string, unknown> };
};

function mergeResults(...parts: unknown[]): ScriptResult {
  const result: ScriptResult = {
    commands: [],
    ui: { bindings: {} },
  };

  for (const part of parts) {
    if (!part || typeof part !== "object") continue;
    const value = part as ScriptResult;

    if (value.exit_requested === true) {
      result.exit_requested = true;
    }
    if (value.runtime?.exit_requested === true) {
      result.runtime = { exit_requested: true };
    }
    if (Array.isArray(value.commands)) {
      result.commands!.push(...value.commands);
    }
    if (Array.isArray(value.scene?.commands)) {
      result.commands!.push(...value.scene!.commands!);
    }
    if (value.ui?.bindings && typeof value.ui.bindings === "object") {
      Object.assign(result.ui!.bindings!, value.ui.bindings);
    }
  }

  return result;
}

export function on_start(payload: unknown): unknown {
  const result = mergeResults(
    livingWorldDemo.start(payload),
    livingTransport.start(payload),
    startWorldLighting(payload),
    startGame(),
  );
  result.commands!.push(...Events.drainCommands());
  return result;
}

export function on_frame(payload: unknown): unknown {
  const result = mergeResults(
    livingWorldDemo.frame(payload),
    livingTransport.frame(payload),
    frameWorldLighting(payload as { elapsed_seconds?: number }),
    frameGame(payload),
  );
  result.commands!.push(...Events.drainCommands());
  return result;
}

export function on_event(event: unknown): unknown {
  Events.dispatchIncoming(event as any);
  return {};
}

export function on_shutdown(payload: unknown): unknown {
  const result = mergeResults(
    shutdownGame(),
    shutdownWorldLighting(payload),
  );
  result.commands!.push(...Events.drainCommands());
  return result;
}
