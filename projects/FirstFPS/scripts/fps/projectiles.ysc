import { CFG } from "./config.ysc";
import { direction } from "./math.ysc";
import { Projectile } from "./state.ysc";

type Vec3 = [number, number, number];

export type ProjectileSpawn = {
  projectiles: Projectile[];
  commands: unknown[];
};

let nextProjectileEntity = 1_000_000;

function allocateProjectileEntity(): number {
  const entity = nextProjectileEntity;
  nextProjectileEntity += 1;
  if (nextProjectileEntity >= 9_000_000_000) {
    nextProjectileEntity = 1_000_000;
  }
  return entity;
}

export function destroyProjectileCommands(projectiles: Projectile[]): unknown[] {
  return projectiles.map((projectile) => ({
    op: "physics.body.destroy",
    entity: projectile.entity,
  }));
}

export function spawnProjectile(
  projectiles: Projectile[],
  position: Vec3,
  yaw: number,
  pitch: number,
): ProjectileSpawn {
  const dir = direction(yaw, pitch);
  const entity = allocateProjectileEntity();
  const spawnPosition: Vec3 = [
    position[0] + dir[0] * CFG.projectileSpawnClearance,
    position[1] + dir[1] * CFG.projectileSpawnClearance,
    position[2] + dir[2] * CFG.projectileSpawnClearance,
  ];

  // Initial spin makes rotation immediately observable; after contact Jolt owns
  // all angular response, rolling friction, impulses and further collisions.
  const spin = CFG.projectileSpeed / CFG.projectileRadius * CFG.projectileInitialSpinScale;
  const angularVelocity: Vec3 = [
    dir[2] * spin,
    0,
    -dir[0] * spin,
  ];

  const retained = projectiles.slice(-(CFG.maxProjectiles - 1));
  const retainedIds = new Set(retained.map((projectile) => projectile.entity));
  const evicted = projectiles.filter((projectile) => !retainedIds.has(projectile.entity));

  return {
    projectiles: [...retained, { entity }],
    commands: [
      ...destroyProjectileCommands(evicted),
      {
        op: "physics.body.upsert",
        entity,
        body_kind: "dynamic",
        shape: {
          kind: "sphere",
          radius: CFG.projectileRadius,
        },
        position: spawnPosition,
        rotation: [0, 0, 0, 1],
        linear_velocity: [
          dir[0] * CFG.projectileSpeed,
          dir[1] * CFG.projectileSpeed,
          dir[2] * CFG.projectileSpeed,
        ],
        angular_velocity: angularVelocity,
        friction: CFG.projectileFriction,
        restitution: CFG.projectileRestitution,
        density: CFG.projectileDensity,
        continuous_collision: true,
        participates_in_queries: true,
        casts_contacts: true,
        linear_damping: CFG.projectileLinearDamping,
        angular_damping: CFG.projectileAngularDamping,
      },
    ],
  };
}
