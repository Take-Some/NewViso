export type Vec3 = [number, number, number];
export type Vec4 = [number, number, number, number];

export function clamp(v: number, min: number, max: number): number {
  return Math.max(min, Math.min(max, v));
}

export function finite(v: unknown, fallback = 0): number {
  return typeof v === "number" && Number.isFinite(v) ? v : fallback;
}

export function has(items: unknown, code: number): boolean {
  return Array.isArray(items) && items.includes(code);
}

export function shortestAngle(v: number): number {
  const tau = Math.PI * 2;
  let a = (v + Math.PI) % tau;
  if (a < 0) a += tau;
  return a - Math.PI;
}

export function direction(yaw: number, pitch: number): Vec3 {
  const cp = Math.cos(pitch);
  return [Math.sin(yaw) * cp, Math.sin(pitch), -Math.cos(yaw) * cp];
}

export function copy3(v: Vec3): Vec3 {
  return [v[0], v[1], v[2]];
}

export function cameraVector(value: any, fallback: Vec3): Vec3 {
  if (!value || typeof value !== "object") return copy3(fallback);
  return [
    finite(value.x, fallback[0]),
    finite(value.y, fallback[1]),
    finite(value.z, fallback[2]),
  ];
}
