 if(layer==1)return nv_unpack(NV_TEX_SAND[i]);
 if(layer==2)return nv_unpack(NV_TEX_ROCK[i]);
 if(layer==3)return nv_unpack(NV_TEX_SOIL[i]);
 return nv_unpack(NV_TEX_WOOD[i]);
}
vec3 nv_texture(int layer,vec2 uv){
 vec2 p=uv*8.0;ivec2 q=ivec2(floor(p));vec2 w=fract(p);
 w=w*w*(3.0-2.0*w);
 return mix(mix(nv_texel(layer,q),nv_texel(layer,q+ivec2(1,0)),w.x),
 mix(nv_texel(layer,q+ivec2(0,1)),nv_texel(layer,q+ivec2(1,1)),w.x),w.y);
}
